# Auto detect text files and perform LF normalization
* text=auto

# Visual Studio files keep Windows line endings
*.sln          text eol=crlf
*.csproj       text eol=crlf
*.cs           text eol=crlf diff=csharp
*.xaml         text eol=crlf
*.appxmanifest text eol=crlf
*.rd.xml       text eol=crlf

# Binary design files from 2017
*.xcf   binary
*.xlsx  binary
*.pdf   binary diff=astextplain
*.png   binary
*.jpg   binary
*.mp4   binary
*.woff2 binary
