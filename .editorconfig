root = true

[*]
charset = utf-8
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{xml,xaml,csproj,props,targets,sln,appxmanifest,json,yml,yaml}]
indent_size = 2
end_of_line = crlf

[*.{md,html,css,js}]
indent_size = 2
end_of_line = lf

# The 2017 code under legacy/ is kept as it was. Don't reformat it.
[legacy/**]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
indent_size = unset
